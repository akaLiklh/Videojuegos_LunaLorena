<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <ui:VisualElement name="Raiz" class="hud-raiz" picking-mode="Ignore">

        <ui:VisualElement name="PanelHud" class="hud-panel" picking-mode="Ignore">
            <ui:VisualElement class="hud-esq hud-esq-si" picking-mode="Ignore" />
            <ui:VisualElement class="hud-esq hud-esq-sd" picking-mode="Ignore" />
            <ui:VisualElement class="hud-esq hud-esq-ii" picking-mode="Ignore" />
            <ui:VisualElement class="hud-esq hud-esq-id" picking-mode="Ignore" />

            <ui:Label text="VIDA" class="hud-etiqueta" picking-mode="Ignore" />
            <ui:VisualElement name="Corazones" class="corazones" picking-mode="Ignore" />

            <ui:VisualElement class="hud-fila-puntos" picking-mode="Ignore">
