<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <Style src="project://database/Assets/UI/Menus/Principal/EstilosMenuPrincipal.uss" />
    <ui:VisualElement name="Fondo" style="flex-grow: 1; background-color: rgb(0, 0, 0); align-items: center; justify-content: center;">
        <ui:VisualElement name="Imagen" picking-mode="Ignore" style="width: 1280px; height: 720px; -unity-background-scale-mode: scale-to-fit;" />
        <ui:Label name="txtSubtitulo" picking-mode="Ignore" text="" style="width: 1400px; margin-top: 30px; font-size: 40px; color: rgb(220, 210, 245); -unity-text-align: middle-center; white-space: normal;" />
        <ui:Button name="bSaltar" text="Saltar" class="boton" style="position: absolute; right: 40px; bottom: 40px; width: 220px;" />
    </ui:VisualElement>
</ui:UXML>